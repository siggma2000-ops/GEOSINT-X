[app]
title = GEOSINT X
package.name = geosintx
package.domain = org.geosintx
source.dir = .
source.include_exts = py,kv,png,jpg,atlas,json
version = 2.0.1
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET
android.api = 35
android.minapi = 24
android.ndk_api = 24
android.archs = arm64-v8a
android.accept_sdk_license = True

[buildozer]
log_level = 2
warn_on_root = 0
